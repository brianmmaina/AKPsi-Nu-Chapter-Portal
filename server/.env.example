# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/family_trees

# Authentication
# Member password for the /api/auth endpoint (read access)
PASSWORD=your_secure_password_here

# Officer/admin password (write access: roster edits, trees, hub posts).
# Falls back to PASSWORD if unset — always set a distinct value in production.
ADMIN_PASSWORD=your_officer_password_here

# JWT Secret — REQUIRED in production (server refuses to start without it)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Configuration
# The stable production frontend URL (without trailing slash)
# Example: https://ak-psi-nu-chapter-portal.vercel.app
FRONTEND_URL=https://ak-psi-nu-chapter-portal.vercel.app
