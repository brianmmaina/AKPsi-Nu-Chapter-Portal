# ============================================================================
# CLIENT ENVIRONMENT VARIABLES (Vite — set these in Vercel for production)
# ============================================================================

# Chapter API base URL (the deployed Express server). Required.
VITE_API_URL=https://your-server.up.railway.app

# Supabase points database (optional — points fall back to Sheets/local without it)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Google Sheets points source (optional — primary points source when set)
VITE_GOOGLE_SHEETS_ID=your_sheet_id
VITE_GOOGLE_SHEETS_API_KEY=your_api_key
